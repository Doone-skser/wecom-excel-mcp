[Unit]
Description=wecom-excel MCP over HTTP (cookies come from each caller, never stored)
After=network-online.target
Wants=network-online.target

[Service]
User=wecom-excel
Group=wecom-excel
# deploy/install.sh replaces wecom.example.com with your domain
ExecStart=/opt/wecom-excel/venv/bin/wecom-excel-mcp --transport streamable-http --host 127.0.0.1 --port 8765 --caller-cookies-only --allowed-hosts wecom.example.com --usage-db /var/lib/wecom-excel/usage.db
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# usage statistics (no cookies), the /admin credentials and the session key: /var/lib/wecom-excel/
StateDirectory=wecom-excel

[Install]
WantedBy=multi-user.target
